FROM alpine:edge

RUN set -ex \
    && echo https://dl-cdn.alpinelinux.org/alpine/edge/testing >> /etc/apk/repositories \
    && apk update \
    && apk upgrade \
    && apk add --no-cache \
    bash iproute2 iptables iputils tcpdump conntrack-tools \
    redis nginx qperf iperf3 iperf net-tools curl wrk

WORKDIR /fabric
COPY test-server /fabric/test-server
COPY test-server.sh /fabric/test-server.sh
RUN chmod +x /fabric/test-server.sh
CMD ["bash", "test-server.sh"]
